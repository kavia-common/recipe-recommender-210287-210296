# Frontend configuration (do not commit .env with secrets)
# Base URL for backend API
REACT_APP_API_BASE_URL=https://your-backend.example.com/api

# Optional: Audit API base URL (POST /audit)
REACT_APP_AUDIT_API_BASE_URL=https://your-audit.example.com

# Site URL is used by auth flows in future (Supabase or other)
REACT_APP_SITE_URL=http://localhost:3000
